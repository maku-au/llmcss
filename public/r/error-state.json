{
  "id": "error-state",
  "name": "Error State",
  "description": "Section-level failure with retry and report actions. Same shape as the empty state, danger tone, no alarm styling.",
  "category": "application",
  "tier": "free",
  "tags": [
    "error",
    "failure",
    "retry",
    "empty-state"
  ],
  "html": "<div class=\"empty-state is-error\" style=\"max-width: 28rem;\">\n  <div class=\"empty-state-icon\"><svg width=\"18\" height=\"18\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\" aria-hidden=\"true\"><circle cx=\"12\" cy=\"12\" r=\"9\"/><path d=\"M12 8v4\"/><path d=\"M12 16h.01\"/></svg></div>\n  <h3 class=\"empty-state-title\">Could not load deployments</h3>\n  <p class=\"empty-state-description\">The API returned 503 twice. Nothing was changed. Try again, or send the request id to support.</p>\n  <div class=\"flex gap-2 justify-center\" style=\"margin-top: var(--ai-space-4);\">\n    <button type=\"button\" class=\"btn btn-primary btn-sm\">Retry</button>\n    <button type=\"button\" class=\"btn btn-outline btn-sm\">Copy request id</button>\n  </div>\n</div>"
}