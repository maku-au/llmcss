{
  "id": "approval-bar",
  "name": "Approval Bar",
  "description": "Pending action bar with a warning accent and pip, the tool call in mono, and quiet deny, outline edit and primary allow once actions.",
  "category": "application",
  "tier": "free",
  "tags": [
    "agent",
    "approval",
