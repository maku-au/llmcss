{
  "id": "ai-chat-thread",
  "name": "AI Conversational Thread",
  "description": "Chat transcript with avatar rows, role labels and mono timestamps, an inline tool call, a streaming turn, and a prompt composer.",
  "category": "application",
  "tier": "free",
  "tags": [
    "chat",
