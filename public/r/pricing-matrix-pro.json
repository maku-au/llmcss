    "pricing",
    "matrix",
    "comparison",
    "table",
    "marketing"
  ],
  "html": "<div class=\"matrix-container\">\n  <table class=\"matrix-table\">\n    <thead>\n      <tr>\n        <th class=\"matrix-feature-col w-2/5\">Core Capabilities</th>\n        <th class=\"w-1/5\">Free</th>\n        <th class=\"w-1/5\" style=\"background-color: var(--ai-surface-1);\">Pro ($9/mo)</th>\n        <th class=\"w-1/5\">Enterprise</th>\n      </tr>\n    </thead>\n    <tbody>\n      <tr>\n        <td colspan=\"4\" class=\"matrix-category-header\">Engine & Architecture</td>\n      </tr>\n      <tr>\n        <td class=\"matrix-feature-col\">Native CSS Layers (@layer)</td>\n        <td><span class=\"mark mark-yes\" role=\"img\" aria-label=\"Yes\"></span></td>\n        <td style=\"background-color: var(--ai-surface-1);\"><span class=\"mark mark-yes\" role=\"img\" aria-label=\"Yes\"></span></td>\n        <td><span class=\"mark mark-yes\" role=\"img\" aria-label=\"Yes\"></span></td>\n      </tr>\n      <tr>\n        <td class=\"matrix-feature-col\">Light-DOM Web Components</td>\n        <td><span class=\"mark mark-yes\" role=\"img\" aria-label=\"Yes\"></span></td>\n        <td style=\"background-color: var(--ai-surface-1);\"><span class=\"mark mark-yes\" role=\"img\" aria-label=\"Yes\"></span></td>\n        <td><span class=\"mark mark-yes\" role=\"img\" aria-label=\"Yes\"></span></td>\n      </tr>\n      <tr>\n        <td class=\"matrix-feature-col\">Container Query Layouts</td>\n        <td><span class=\"mark mark-yes\" role=\"img\" aria-label=\"Yes\"></span></td>\n        <td style=\"background-color: var(--ai-surface-1);\"><span class=\"mark mark-yes\" role=\"img\" aria-label=\"Yes\"></span></td>\n        <td><span class=\"mark mark-yes\" role=\"img\" aria-label=\"Yes\"></span></td>\n      </tr>\n      <tr>\n        <td colspan=\"4\" class=\"matrix-category-header\">Component Library</td>\n      </tr>\n      <tr>\n        <td class=\"matrix-feature-col\">Core UI Primitives</td>\n        <td>20+ Primitives</td>\n        <td class=\"font-semibold\" style=\"background-color: var(--ai-surface-1);\">All 40+ Primitives</td>\n        <td>All + Custom</td>\n      </tr>\n      <tr>\n        <td class=\"matrix-feature-col\">High-Craft Bento Heroes</td>\n        <td class=\"text-muted\">-</td>\n        <td class=\"text-accent font-semibold\" style=\"background-color: var(--ai-surface-1);\"><span class=\"mark mark-yes\" role=\"img\" aria-label=\"Yes\"></span>Pro Bento Kit</td>\n        <td><span class=\"mark mark-yes\" role=\"img\" aria-label=\"Yes\"></span>Bespoke</td>\n      </tr>\n      <tr>\n        <td class=\"matrix-feature-col\">Conversational AI Threads</td>\n        <td class=\"text-muted\">-</td>\n        <td class=\"text-accent font-semibold\" style=\"background-color: var(--ai-surface-1);\"><span class=\"mark mark-yes\" role=\"img\" aria-label=\"Yes\"></span>Full App Kits</td>\n        <td><span class=\"mark mark-yes\" role=\"img\" aria-label=\"Yes\"></span>Full App Kits</td>\n      </tr>\n      <tr>\n        <td colspan=\"4\" class=\"matrix-category-header\">Tooling & Agent Integration</td>\n      </tr>\n      <tr>\n        <td class=\"matrix-feature-col\">CLI Tooling (llmcss add)</td>\n        <td>Free Registry</td>\n        <td class=\"font-semibold\" style=\"background-color: var(--ai-surface-1);\">Full Pro Access</td>\n        <td>Private Registry</td>\n      </tr>\n      <tr>\n        <td class=\"matrix-feature-col\">Stdio MCP Server for AI Agents</td>\n        <td><span class=\"mark mark-yes\" role=\"img\" aria-label=\"Yes\"></span>Standard</td>\n        <td style=\"background-color: var(--ai-surface-1);\"><span class=\"mark mark-yes\" role=\"img\" aria-label=\"Yes\"></span>Priority API</td>\n        <td><span class=\"mark mark-yes\" role=\"img\" aria-label=\"Yes\"></span>Dedicated Instance</td>\n      </tr>\n    </tbody>\n  </table>\n</div>",
  "variants": [
    {
      "id": "grouped-rows",
      "name": "Grouped rows",
      "description": "Each capability group becomes its own table body opened by a category header row, so the matrix reads as three short tables rather than one long one.",
      "guidance": "Sits on a dedicated pricing page below the plan cards. Best when there are more than about ten feature rows and a reader needs to jump to the group they care about. Avoid it for fewer than six rows, because three headings over six rows is more structure than content. Pairs with pricing-tier-cards above, and the category rows give a screen reader something to announce between sections.",
      "html": "<div class=\"matrix-container\">\n  <table class=\"matrix-table\">\n    <caption class=\"sr-only\">Capabilities by plan, grouped by category</caption>\n    <thead>\n      <tr>\n        <th class=\"matrix-feature-col\">Core Capabilities</th>\n        <th>Free</th>\n        <th>Pro ($9/mo)</th>\n        <th>Enterprise</th>\n      </tr>\n    </thead>\n    <tbody>\n      <tr><th colspan=\"4\" scope=\"colgroup\" class=\"matrix-category-header\">Engine and architecture</th></tr>\n      <tr>\n        <td class=\"matrix-feature-col\">Native CSS Layers</td>\n        <td><span class=\"mark mark-yes\" role=\"img\" aria-label=\"Yes\"></span></td>\n        <td><span class=\"mark mark-yes\" role=\"img\" aria-label=\"Yes\"></span></td>\n        <td><span class=\"mark mark-yes\" role=\"img\" aria-label=\"Yes\"></span></td>\n      </tr>\n      <tr>\n        <td class=\"matrix-feature-col\">Light-DOM Web Components</td>\n        <td><span class=\"mark mark-yes\" role=\"img\" aria-label=\"Yes\"></span></td>\n        <td><span class=\"mark mark-yes\" role=\"img\" aria-label=\"Yes\"></span></td>\n        <td><span class=\"mark mark-yes\" role=\"img\" aria-label=\"Yes\"></span></td>\n      </tr>\n      <tr>\n        <td class=\"matrix-feature-col\">Container Query Layouts</td>\n        <td><span class=\"mark mark-yes\" role=\"img\" aria-label=\"Yes\"></span></td>\n        <td><span class=\"mark mark-yes\" role=\"img\" aria-label=\"Yes\"></span></td>\n        <td><span class=\"mark mark-yes\" role=\"img\" aria-label=\"Yes\"></span></td>\n      </tr>\n    </tbody>\n    <tbody>\n      <tr><th colspan=\"4\" scope=\"colgroup\" class=\"matrix-category-header\">Component library</th></tr>\n      <tr>\n        <td class=\"matrix-feature-col\">Core UI Primitives</td>\n        <td>20+ Primitives</td>\n        <td>All 40+ Primitives</td>\n        <td>All plus custom</td>\n      </tr>\n      <tr>\n        <td class=\"matrix-feature-col\">High-Craft Bento Heroes</td>\n        <td class=\"text-muted\">Not included</td>\n        <td><span class=\"mark mark-yes\" role=\"img\" aria-label=\"Yes\"></span>Pro Bento Kit</td>\n        <td><span class=\"mark mark-yes\" role=\"img\" aria-label=\"Yes\"></span>Bespoke</td>\n      </tr>\n      <tr>\n        <td class=\"matrix-feature-col\">Conversational AI Threads</td>\n        <td class=\"text-muted\">Not included</td>\n        <td><span class=\"mark mark-yes\" role=\"img\" aria-label=\"Yes\"></span>Full App Kits</td>\n        <td><span class=\"mark mark-yes\" role=\"img\" aria-label=\"Yes\"></span>Full App Kits</td>\n      </tr>\n    </tbody>\n    <tbody>\n      <tr><th colspan=\"4\" scope=\"colgroup\" class=\"matrix-category-header\">Tooling and agent integration</th></tr>\n      <tr>\n        <td class=\"matrix-feature-col\">CLI Tooling (llmcss add)</td>\n        <td>Free Registry</td>\n        <td>Full Pro Access</td>\n        <td>Private Registry</td>\n      </tr>\n      <tr>\n        <td class=\"matrix-feature-col\">Stdio MCP Server for AI Agents</td>\n        <td><span class=\"mark mark-yes\" role=\"img\" aria-label=\"Yes\"></span>Standard</td>\n        <td><span class=\"mark mark-yes\" role=\"img\" aria-label=\"Yes\"></span>Priority API</td>\n        <td><span class=\"mark mark-yes\" role=\"img\" aria-label=\"Yes\"></span>Dedicated Instance</td>\n      </tr>\n    </tbody>\n  </table>\n</div>"
    },
    {
      "id": "two-plan-compact",
      "name": "Two plan compact",
      "description": "Two plan columns instead of four, on the compact table density, with the capability column pinned to the left edge while the rest scrolls.",
      "guidance": "Sits on a pricing page for an open core product, or inside an upgrade modal where vertical space is short. Best when the only question is what the paid tier adds to the free one. Avoid it when enterprise terms are part of the decision, because there is no column left to put them in. Pairs with pricing-tier-cards:two-tier above it, whose two cards this table expands.",
      "html": "<div class=\"scroll-x\">\n  <table class=\"table table-compact\">\n    <caption class=\"sr-only\">Free and Pro compared</caption>\n    <thead>\n      <tr>\n        <th class=\"matrix-feature-col\">Core capability</th>\n        <th>Free</th>\n        <th>Pro ($9/mo)</th>\n      </tr>\n    </thead>\n    <tbody>\n      <tr><th colspan=\"3\" scope=\"colgroup\" class=\"matrix-category-header\">Engine and architecture</th></tr>\n      <tr>\n        <td class=\"matrix-feature-col\">Native CSS Layers</td>\n        <td><span class=\"mark mark-yes\" role=\"img\" aria-label=\"Yes\"></span></td>\n        <td><span class=\"mark mark-yes\" role=\"img\" aria-label=\"Yes\"></span></td>\n      </tr>\n      <tr>\n        <td class=\"matrix-feature-col\">Container Query Layouts</td>\n        <td><span class=\"mark mark-yes\" role=\"img\" aria-label=\"Yes\"></span></td>\n        <td><span class=\"mark mark-yes\" role=\"img\" aria-label=\"Yes\"></span></td>\n      </tr>\n      <tr><th colspan=\"3\" scope=\"colgroup\" class=\"matrix-category-header\">Component library</th></tr>\n      <tr>\n        <td class=\"matrix-feature-col\">Core UI Primitives</td>\n        <td>20+ Primitives</td>\n        <td>All 40+ Primitives</td>\n      </tr>\n      <tr>\n        <td class=\"matrix-feature-col\">High-Craft Bento Heroes</td>\n        <td><span class=\"mark mark-no\" role=\"img\" aria-label=\"No\"></span></td>\n        <td><span class=\"mark mark-yes\" role=\"img\" aria-label=\"Yes\"></span>Pro Bento Kit</td>\n      </tr>\n      <tr><th colspan=\"3\" scope=\"colgroup\" class=\"matrix-category-header\">Tooling and agent integration</th></tr>\n      <tr>\n        <td class=\"matrix-feature-col\">CLI Tooling (llmcss add)</td>\n        <td>Free Registry</td>\n        <td>Full Pro Access</td>\n      </tr>\n      <tr>\n        <td class=\"matrix-feature-col\">Stdio MCP Server for AI Agents</td>\n        <td><span class=\"mark mark-yes\" role=\"img\" aria-label=\"Yes\"></span>Standard</td>\n        <td><span class=\"mark mark-yes\" role=\"img\" aria-label=\"Yes\"></span>Priority API</td>\n      </tr>\n    </tbody>\n  </table>\n</div>"
