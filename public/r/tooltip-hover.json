{
  "id": "tooltip-hover",
  "name": "CSS Tooltip",
  "description": "Pure CSS tooltip on hover and focus. No JavaScript required. Supports top and bottom placement.",
  "category": "primitive",
  "tier": "free",
  "tags": [
    "tooltip",
    "hover",
    "popover",
    "hint"
  ],
  "html": "<div class=\"flex flex-wrap gap-6 items-center\">\n  <span class=\"tooltip\" data-tooltip=\"Edit this item\">\n    <button class=\"btn btn-outline btn-sm\" aria-describedby=\"tip-edit\">Hover me (top)</button>\n    <span class=\"sr-only\" id=\"tip-edit\" role=\"tooltip\">Edit this item</span>\n  </span>\n  <span class=\"tooltip tooltip-bottom\" data-tooltip=\"Save changes\">\n    <button class=\"btn btn-secondary btn-sm\" aria-describedby=\"tip-save\">Hover me (bottom)</button>\n    <span class=\"sr-only\" id=\"tip-save\" role=\"tooltip\">Save changes</span>\n  </span>\n  <span class=\"tooltip\" data-tooltip=\"Keyboard accessible too\">\n    <button class=\"btn btn-ghost btn-sm\" aria-describedby=\"tip-focus\">Focus me</button>\n    <span class=\"sr-only\" id=\"tip-focus\" role=\"tooltip\">Keyboard accessible too</span>\n  </span>\n</div>"
}