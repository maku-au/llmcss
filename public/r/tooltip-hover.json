{
  "id": "tooltip-hover",
  "name": "CSS Tooltip",
  "description": "Pure CSS tooltip on hover and focus. No JavaScript required. Supports top and bottom placement.",
  "category": "primitive",
  "tier": "free",
  "tags": [
    "tooltip",
    "hover",
    "popover",
